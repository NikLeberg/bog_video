# ignore build artifacts but keep build scripts
build/*/*
!build/*/*.sh
!build/*/*.tcl

# ignore quartus generated files but keep project config
!build/gecko4/quartus/
build/gecko4/quartus/*/
build/gecko4/quartus/*.qws
build/gecko4/quartus/*.log

# ignore software build artifacts
sw/build
sw/elf.bin
sw/main.elf
sw/main.asm
sw/*.vhd
